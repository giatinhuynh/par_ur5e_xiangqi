# Low-level pick-and-place action handled by the manipulation node.
# The manipulation_node uses the OnRobot RG2 two-finger gripper.
# Gripper open/close widths and force are configured in manipulation_config.yaml.
geometry_msgs/Pose pick_pose     # World-frame pose (robot base_link) to pick from
geometry_msgs/Pose place_pose    # World-frame pose (robot base_link) to place at
float32 approach_height          # Z offset above target for approach/depart (metres)
float32 transit_height           # Z height for lateral transit between pick and place
---
bool success
float32 placement_error_mm       # Estimated error from target in mm
string message
---
string phase   # "opening_gripper" | "approaching_pick" | "descending_to_piece" | "grasping_piece" | "lifting" | "transiting" | "descending_to_place" | "releasing_piece" | "lifting_clear"
