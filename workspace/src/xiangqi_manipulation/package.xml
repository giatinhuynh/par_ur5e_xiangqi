<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>xiangqi_manipulation</name>
  <version>0.1.0</version>
  <description>Pick-and-place, RG2 gripper bridge, and safety monitor for the Xiangqi robot.</description>
  <maintainer email="student@rmit.edu.au">Xiangqi Team</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>xiangqi_msgs</depend>

  <!-- Lab infrastructure (UR5e_Env base image) -->
  <depend>onrobot_rg2_msgs</depend>     <!-- GripperSetWidth action + GripperState msg -->
  <depend>ur_dashboard_msgs</depend>    <!-- SafetyMode msg (safety_monitor_node) -->
  <depend>ament_index_python</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
