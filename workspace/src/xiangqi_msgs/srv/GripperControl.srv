# Open or close the OnRobot RG2 two-finger gripper to a target width.
# target_width: desired jaw opening in millimetres (0 = fully closed, 110 = fully open)
# target_force: gripping force in Newtons (0–40 N)
float32 target_width
float32 target_force
---
bool success
float32 final_width
string message
